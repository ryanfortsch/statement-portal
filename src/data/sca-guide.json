{"refreshedAt":"2026-11-11T13:01:28.969Z","source":"stay-cape-ann data/attractions.json + data/nearby-distances.json + data/ical-urls.json","distancesGeneratedAt":"2026-08-04T01:43:16.267Z","attractions":[{"name":"Good Harbor Beach","category":"beach","town":"Gloucester","lat":42.6195,"lng":-70.6314,"blurb":"The Cape's signature beach. Wide at low tide, soft sand, lifeguards on duty in summer.","anchor":true},{"name":"Downtown Gloucester","category":"landmark","town":"Gloucester","lat":42.6128,"lng":-70.6604,"blurb":"Main Street, the working waterfront, and the country's oldest seaport. Restaurants, galleries, and the schooner fleet in one walkable mile.","anchor":true},{"name":"Downtown Rockport","category":"landmark","town":"Rockport","lat":42.6593,"lng":-70.6196,"blurb":"Dock Square, Bearskin Neck, and the Shalin Liu all within a few blocks. The walkable heart of Rockport.","anchor":true},{"name":"Wingaersheek Beach","category":"beach","town":"Gloucester","lat":42.6501,"lng":-70.6842,"blurb":"Calm, shallow water and granite outcrops. Go at low tide for the full sandbar walk."},{"name":"Niles Beach","category":"beach","town":"Gloucester","lat":42.5959,"lng":-70.6544,"blurb":"Small, quiet, and locals-only in feel. Sunrise here is a ritual."},{"name":"Long Beach","category":"beach","town":"Rockport","lat":42.6301,"lng":-70.6166,"blurb":"A half-mile of open Atlantic between Gloucester and Rockport. Bigger waves than the protected coves."},{"name":"Old Garden Beach","category":"beach","town":"Rockport","lat":42.6571,"lng":-70.6128,"blurb":"Tiny cove just past Bearskin Neck. Tide pools, clear water, no parking lot."},{"name":"Front Beach","category":"beach","town":"Rockport","lat":42.6588,"lng":-70.6216,"blurb":"Steps from downtown Rockport. The in-town swim when you don't feel like driving."},{"name":"Back Beach","category":"beach","town":"Rockport","lat":42.6618418,"lng":-70.6238289,"blurb":"Rockport's quieter town beach. Calm water, tide pools, and an easy walk to downtown."},{"name":"Pebble Beach","category":"beach","town":"Rockport","lat":42.6362,"lng":-70.6086,"blurb":"Smooth granite pebbles instead of sand. Best at low tide, best barefoot."},{"name":"Crane Beach","category":"beach","town":"Ipswich","lat":42.6784,"lng":-70.7414,"blurb":"Four miles of protected barrier beach. Trustees-managed, worth the short drive."},{"name":"Eastern Point Light","category":"landmark","town":"Gloucester","lat":42.5802,"lng":-70.6645,"blurb":"1832 lighthouse at the mouth of Gloucester Harbor. Walk out on the Dog Bar breakwater."},{"name":"Annisquam Light","category":"landmark","town":"Gloucester","lat":42.6619,"lng":-70.6815,"blurb":"The small white tower at Wigwam Point. Framed perfectly at golden hour."},{"name":"Motif No. 1","category":"landmark","town":"Rockport","lat":42.6595,"lng":-70.6164,"blurb":"The red fishing shack on Bradley Wharf. Called the most painted building in America."},{"name":"Bearskin Neck","category":"landmark","town":"Rockport","lat":42.6597,"lng":-70.6178,"blurb":"The granite peninsula in downtown Rockport. Galleries, saltwater taffy, harbor views."},{"name":"Rocky Neck","category":"landmark","town":"Gloucester","lat":42.6071,"lng":-70.656,"blurb":"America's oldest working art colony. Galleries, studios, and harborside dining on a little neck in Smith Cove."},{"name":"Hammond Castle","category":"cultural","town":"Gloucester","lat":42.5851,"lng":-70.6925,"blurb":"A medieval-style castle on the coast, built in 1929. Opens late April through mid-November."},{"name":"Cape Ann Museum","category":"cultural","town":"Gloucester","lat":42.614,"lng":-70.6616,"blurb":"The region's cultural anchor. Fitz Henry Lane's maritime paintings, plus rotating exhibitions."},{"name":"Maritime Gloucester","category":"cultural","town":"Gloucester","lat":42.6111,"lng":-70.6589,"blurb":"Working waterfront museum at Harbor Loop. Schooner Ardelle sails from here May through October."},{"name":"Rockport Art Association","category":"cultural","town":"Rockport","lat":42.6581,"lng":-70.6177,"blurb":"Founded 1921. Rotating shows from one of the oldest active art colonies on the East Coast."},{"name":"Shalin Liu Performance Center","category":"cultural","town":"Rockport","lat":42.6584,"lng":-70.6189,"blurb":"Concert hall with a glass wall onto Sandy Bay. Shows year-round, and the chamber music festival takes over for a month each summer."},{"name":"Halibut Point State Park","category":"outdoors","town":"Rockport","lat":42.6893,"lng":-70.6328,"blurb":"Abandoned granite quarry on the Atlantic. Easy loop trail, best view on Cape Ann."},{"name":"Stage Fort Park","category":"outdoors","town":"Gloucester","lat":42.6057,"lng":-70.6785,"blurb":"Cressy's and Half Moon beaches, a granite headland, and the 1623 founding site in one park."},{"name":"Ravenswood Park","category":"outdoors","town":"Gloucester","lat":42.5999,"lng":-70.6992,"blurb":"600 wooded acres with trail networks for an hour or a half-day. A Trustees property."},{"name":"Dogtown","category":"outdoors","town":"Gloucester","lat":42.6362,"lng":-70.6648,"blurb":"Miles of quiet hiking trails in the woods above Gloucester. Famous for the Babson Boulders, one-word mottoes (COURAGE, LOYALTY, INDUSTRY) carved into granite during the Depression."},{"name":"Castle Hill on the Crane Estate","category":"cultural","town":"Ipswich","lat":42.6854,"lng":-70.7791,"blurb":"Grand allee, Gilded Age mansion, Atlantic views. Trustees property adjacent to Crane Beach."}],"listings":{"67a1355216416a00122e976f":{"internalName":"21 Horton","publicName":"Stay at Rocky Neck","favorites":[{"name":"Tonno","category":"dining","town":"Gloucester","lat":42.6115,"lng":-70.6662,"blurb":"Coastal Italian with fresh pasta, a raw bar, and an always-full dining room. Go early or sit at the bar.","primary":true},{"name":"The Salted Cod Arthouse","category":"dining","town":"Gloucester","lat":42.6059,"lng":-70.657,"blurb":"A short walk down the Neck. Small-plates and natural wine inside a working a